NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY_HERE
NEXT_PUBLIC_BASE_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
RESEND_API_KEY=re_YOUR_KEY_HERE
# Google Maps / Places / Geocoding — used by:
#   • the stop-location map picker (designer)
#   • the place-search Autocomplete in the stop inspector (designer)
#   • the seeder's `place` resolution for sample-passport stops
#
# Two keys. They can be separate keys with different restrictions, OR
# the same key if you've left it unrestricted in Google Cloud (not
# recommended for production).
#
# Google Cloud APIs that must be ENABLED:
#   • Maps JavaScript API   — browser map + places library
#   • Places API            — browser Autocomplete + Place Details
#   • Geocoding API         — server-side place→coords resolution
#
# Restrictions:
#   • NEXT_PUBLIC_*  — recommended: HTTP referrer restriction to your
#     deployed domain + http://localhost:3000 for dev. Loads in browser.
#   • GOOGLE_MAPS_SERVER_KEY — recommended: IP restriction (your
#     Vercel / Supabase server IPs). Never sent to the browser.
#
# Graceful degradation: leave either / both empty and the corresponding
# features hide themselves (place search, map picker) or skip (seeder
# resolution). Manual entry always works.

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Used only by `npm run seed:passport <template>` — your profiles.id
# (UUID), so seeded sample passports are owned by your designer account.
# Find it in Supabase Studio → Authentication → Users → your row → "ID".
SEED_CREATOR_ID=
