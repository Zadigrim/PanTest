NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY_HERE
NEXT_PUBLIC_BASE_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
RESEND_API_KEY=re_YOUR_KEY_HERE
# Optional. When set, the stop-location form shows a "Pick on map" button
# that opens a Google Maps picker for dropping a lat/long pin. With this
# unset, manual lat/long entry still works fully and the picker is hidden.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Used only by `npm run seed:passport <template>` — your profiles.id
# (UUID), so seeded sample passports are owned by your designer account.
# Find it in Supabase Studio → Authentication → Users → your row → "ID".
SEED_CREATOR_ID=
