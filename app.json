{
  "expo": {
    "name": "Okuji",
    "slug": "okuji",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B2A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.okuji.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Okuji uses your camera to scan QR codes at locations.",
        "NSLocationWhenInUseUsageDescription": "Okuji uses your location only at the moment you stamp a location — never in the background.",
        "NSMicrophoneUsageDescription": "Okuji uses your microphone for voice journal entries.",
        "NSPhotoLibraryUsageDescription": "Okuji accesses your photos for journal entries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1B2A"
      },
      "package": "com.okuji.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "okuji",
    "experiments": {
      "typedRoutes": true
    }
  }
}
