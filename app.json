{
  "expo": {
    "name": "Okuji",
    "slug": "okuji",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-okuji.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f1e6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.okuji.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Okuji uses your camera to scan QR codes at locations.",
        "NSLocationWhenInUseUsageDescription": "Okuji uses your location only at the moment you stamp a location — never in the background.",
        "NSMicrophoneUsageDescription": "Okuji uses your microphone for voice journal entries.",
        "NSPhotoLibraryUsageDescription": "Okuji accesses your photos for journal entries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1B2A"
      },
      "package": "com.okuji.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Okuji uses your microphone for voice journal entries.",
          "speechRecognitionPermission": "Okuji transcribes your voice journal entries on your device — your audio never leaves your phone.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "scheme": "okuji",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e07e442-79ea-4f71-8ef1-2b08edc5a4af"
      }
    }
  }
}
